<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.tjg.twidget.brief.BriefCoachTestActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/Theme.Twidget" />
        <provider android:name=".widget.coloros.ColorOsLockCardProvider">
            <intent-filter><action android:name="pantanal.card.action.RPKCARD_UPDATE" /></intent-filter>
            <meta-data android:name="pantanal.card.provider.array" android:resource="@array/coloros_card_metadata" />
            <meta-data android:name="twidget_coloros_followers" android:resource="@xml/coloros_card_followers" />
            <meta-data android:name="twidget_coloros_brief" android:resource="@xml/coloros_card_brief" />
            <meta-data android:name="twidget_coloros_compact" android:resource="@xml/coloros_card_compact" />
            <meta-data android:name="twidget_coloros_wide" android:resource="@xml/coloros_card_wide" />
        </provider>
        <!-- App-only allowlist probe; the package remains Twidget Debug. -->
        <receiver
            android:name="com.heytap.quicksearchbox.ui.appwidgets.DesktopSearchWidgetProvider"
            android:exported="true"
            android:label="@string/coloros_blur_probe_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_blur" />
        </receiver>
    </application>
</manifest>
