<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/dashboard_root" android:saveEnabled="false"
 android:layout_width="match_parent" android:layout_height="match_parent">
<dev.oneuiproject.oneui.layout.ToolbarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:expanded="false"
    app:handleInsets="false"
    app:mainRoundedCorners="top"
    app:title="@string/app_name">

    <!-- Main content: the selected account's dashboard and scheduling action -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?roundedCornerColor"
        app:layout_location="main_content">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/main_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/main_content_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </FrameLayout>


</dev.oneuiproject.oneui.layout.ToolbarLayout>
 <FrameLayout android:id="@id/responsive_pane_drawer"
  android:layout_width="@dimen/sesl_responsive_pane_navigation_drawer_width"
  android:layout_height="match_parent" android:layout_gravity="start"
  android:layout_marginTop="@dimen/dashboard_drawer_surface_gap"
  android:layout_marginBottom="@dimen/dashboard_drawer_surface_gap"
  android:clipToOutline="true" android:background="@drawable/sesl_menu_popup_background" />
</androidx.drawerlayout.widget.DrawerLayout>
