<?xml version="1.0" encoding="utf-8"?>
<!--
    The activity installs one continuous Brief material behind every stage.
    Scroll fills the middle; the footer pins to the bottom.
-->
<dev.oneuiproject.oneui.widget.AdaptiveCoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_gradient_bg">

    <LinearLayout
        android:id="@+id/onboarding_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/onboarding_scroll"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="28dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="520dp"
                android:paddingStart="@dimen/onboarding_side_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/onboarding_side_padding"
                android:paddingBottom="24dp">

                <!-- Step 1 · Welcome -->
                <LinearLayout
                    android:id="@+id/step_overview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="224dp"
                        android:layout_height="224dp"
                        android:contentDescription="@null"
                        android:src="@drawable/onboarding_twidget_mark" />

                    <com.tjg.twidget.ui.AnimatedTitleView
                        android:id="@+id/overview_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_overview_title"
                        android:textColor="@color/oneui_text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/overview_privacy_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="12dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/onboarding_welcome_terms"
                        android:textColor="?android:textColorSecondary"
                        android:textColorLink="@color/oneui_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step 2 · Permissions -->
                <LinearLayout
                    android:id="@+id/step_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="94dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_permissions_title"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="52dp"
                        android:fontFamily="sec"
                        android:text="@string/onboarding_required_permissions"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/permission_notifications_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="96dp"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_oui_notification_outline"
                            app:tint="?android:textColorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sec"
                                android:text="@string/onboarding_permission_notifications_title"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sec"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/onboarding_permission_notifications_summary"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/permission_notifications_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sec"
                                android:text="@string/onboarding_permission_required"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <!-- Step 3 · Handle -->
                <LinearLayout
                    android:id="@+id/step_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="96dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/profile_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_profile_title"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profile_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:text="@string/onboarding_profile_summary"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />

                    <FrameLayout android:id="@+id/profile_identity_host" android:padding="0dp" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="40dp" android:background="@drawable/onboarding_identity_card" android:clipToOutline="true">
                    <EditText
                        android:id="@+id/username_input"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@android:color/transparent"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:fontFamily="sec"
                        android:hint="@string/onboarding_handle_hint"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:includeFontPadding="false"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?android:textColorPrimary"
                        android:textColorHint="?android:textColorSecondary"
                        android:textSize="19sp" />

                        <LinearLayout android:id="@+id/detected_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:id="@+id/detected_avatar" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/avatar_twidget" android:contentDescription="@null" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                                    <TextView android:id="@+id/detected_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?android:textColorPrimary" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                                    <TextView android:id="@+id/detected_handle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="?android:textColorPrimary" android:textSize="14sp" />
                                </LinearLayout>
                            </LinearLayout>
                            <TextView android:id="@+id/detected_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="?android:textColorSecondary" android:textSize="14sp" android:maxLines="6" android:ellipsize="end" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/username_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sec"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/metric_red"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/share_history_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="36dp"
                        android:orientation="vertical">

                        <CheckBox
                            android:id="@+id/share_history_checkbox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sec"
                            android:text="@string/share_history"
                            android:textColor="?android:textColorPrimary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sec"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="34dp"
                            android:paddingEnd="0dp"
                            android:text="@string/share_history_onboarding_summary"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/confirm_import_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:text="@string/onboarding_optional_import" android:textColor="?android:textColorSecondary" android:textSize="14sp" />
                        <LinearLayout android:id="@+id/confirm_import" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/onboarding_identity_card" android:clipToOutline="true" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings_download" android:contentDescription="@null" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_import_title" android:textColor="?android:textColorPrimary" android:textSize="18sp" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/onboarding_import_summary" android:textColor="?android:textColorSecondary" android:textSize="14sp" />
                            </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/ic_onboarding_row_next" android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>



<LinearLayout android:id="@+id/step_ai" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" android:layout_marginBottom="24dp" android:gravity="center" android:orientation="vertical">
     <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="16dp" android:src="@drawable/onboarding_ai_mark" android:contentDescription="@null" />
     <TextView android:id="@id/collapsing_appbar_extended_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:text="@string/onboarding_ai_title" android:textAppearance="@style/TextAppearance.Design.CollapsingToolbar.Expanded" android:textColor="?android:textColorPrimary" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/onboarding_ai_card" android:clipToOutline="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/ai_brief_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings_brief" android:contentDescription="@null" />
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
 <TextView android:id="@+id/ai_brief_name" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_ai_brief" android:textSize="18sp" android:textColor="?android:textColorPrimary" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/onboarding_ai_brief_summary" android:textSize="14sp" android:textColor="?android:textColorSecondary" />
 </LinearLayout></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:background="@color/onboarding_glass_stroke" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/ai_review_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings_send" android:contentDescription="@null" />
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
 <TextView android:id="@+id/ai_review_name" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_ai_review" android:textSize="18sp" android:textColor="?android:textColorPrimary" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/onboarding_ai_review_summary" android:textSize="14sp" android:textColor="?android:textColorSecondary" />
 </LinearLayout></LinearLayout></LinearLayout>
 <LinearLayout android:id="@+id/ai_readiness_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/onboarding_ai_card" android:clipToOutline="true" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
     <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
         <TextView android:id="@+id/ai_readiness_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_ai_checking" android:textSize="18sp" android:textColor="?android:textColorPrimary" />
         <TextView android:id="@+id/ai_readiness_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/onboarding_ai_checking_summary" android:textSize="14sp" android:textColor="?android:textColorSecondary" />
     </LinearLayout>
     <ImageView android:id="@+id/ai_readiness_indicator" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:contentDescription="@null" android:visibility="gone" />
 </LinearLayout>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/ai_setup_provider" android:background="@drawable/dashboard_report_chip" android:backgroundTint="@null" app:backgroundTint="@null" style="@style/Twidget.WrappingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/onboarding_ai_setup_cloud" android:textAllCaps="false" android:visibility="gone" />
 </LinearLayout></LinearLayout>
                <!-- Step 5 · Add widget -->
                <LinearLayout
                    android:id="@+id/step_widgets"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="94dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/add_widget_title"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:text="@string/onboarding_profile_summary"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />

                    <!-- Preview centres in the space between subtitle and the
                         footer while it cycles through widget sizes. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <FrameLayout
                            android:id="@+id/widget_preview_host"
                            android:layout_width="280dp"
                            android:layout_height="130dp"
                            android:layout_gravity="center">

                            <ImageView
                                android:id="@+id/widget_preview_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Step 6 · Done (title centred; fades up into place) -->
                <LinearLayout
                    android:id="@+id/step_done"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/done_profile_avatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/avatar_twidget"
                        android:contentDescription="@null" />

                    <com.tjg.twidget.main.OnboardingTitleAnimationView
                        android:id="@+id/done_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_done_title"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/done_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sec"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/onboarding_done_summary"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/onboarding_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/onboarding_side_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/onboarding_side_padding"
            android:paddingBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/primary_button"
                android:background="@drawable/dashboard_report_chip"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                style="@style/Twidget.WrappingButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:text="@string/continue_button"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/secondary_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                style="@style/Twidget.WrappingButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:text="@string/advanced_options"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:theme="@style/OneUI.ContainedButtonTheme"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/onboarding_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/onboarding_floating_back_background"
        android:contentDescription="@string/back"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_onboarding_setup_back"
        app:tint="?android:textColorPrimary" />
</dev.oneuiproject.oneui.widget.AdaptiveCoordinatorLayout>
