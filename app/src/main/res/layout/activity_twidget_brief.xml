<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.widget.AdaptiveCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/brief_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/brief_screen_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/brief_app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sesl_action_bar_height_with_padding"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:enabled="false"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/brief_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:contentScrim="@android:color/transparent"
            app:statusBarScrim="@android:color/transparent"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:titleEnabled="false">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/brief_back"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/brief_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/brief_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="16dp"
            android:paddingEnd="10dp"
            android:paddingBottom="32dp">

            <!-- Editorial overview. This is page chrome, not a ranked card. -->
            <LinearLayout
                android:id="@+id/brief_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:paddingStart="19dp"
                android:paddingEnd="19dp">

                <com.tjg.twidget.brief.NowBriefSubtitleMotionView
                    android:id="@+id/brief_summary_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="36sp"
                    android:textStyle="normal" />

                <com.tjg.twidget.brief.NowBriefSubtitleMotionView
                    android:id="@+id/brief_summary_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <include layout="@layout/view_brief_refresh_state" />

            <!-- The engine owns this sequence. On large screens, cards are
                 distributed into independent columns so unequal heights tile
                 without creating shared-row gaps. -->
            <LinearLayout
                android:id="@+id/brief_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <LinearLayout
                android:id="@+id/brief_footer"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="19dp"
                android:paddingEnd="9dp">

                <TextView
                    android:id="@+id/brief_footer_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/brief_footer_info"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/brief_footer_action_button"
                    android:contentDescription="@string/brief_ai_disclaimer"
                    android:padding="13dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/brief_footer_settings"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/brief_footer_action_button"
                    android:contentDescription="@string/brief_settings_title"
                    android:padding="13dp"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/brief_provider_required"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sec"
            android:gravity="center"
            android:includeFontPadding="false"
            android:id="@+id/brief_provider_required_title"
            android:text="@string/brief_provider_required_title"
            android:textColor="@color/oneui_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sec"
            android:gravity="center"
            android:id="@+id/brief_provider_required_body"
            android:text="@string/brief_provider_required_body"
            android:textColor="@color/brief_loading_status_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/brief_provider_required_action"
            style="@style/Twidget.WrappingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/brief_provider_required_action"
            android:textAllCaps="false"
            android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/brief_loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="12dp"
        android:paddingEnd="32dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/brief_loading"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/brief_widget_empty_title"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/intelligence_progress_mono" />

        <TextView
            android:id="@+id/brief_loading_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="sec"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/brief_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/brief_top_bar_gradient"
        android:importantForAccessibility="no" />

</dev.oneuiproject.oneui.widget.AdaptiveCoordinatorLayout>
