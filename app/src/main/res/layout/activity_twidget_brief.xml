<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/brief_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/brief_screen_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/brief_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/brief_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="80dp"
            android:paddingEnd="10dp"
            android:paddingBottom="32dp">

            <!-- Editorial overview. This is page chrome, not a ranked card. -->
            <LinearLayout
                android:id="@+id/brief_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingStart="19dp"
                android:paddingEnd="19dp">

                <TextView
                    android:id="@+id/brief_summary_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/brief_summary_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- The engine owns this sequence. On large screens, cards are
                 distributed into independent columns so unequal heights tile
                 without creating shared-row gaps. -->
            <LinearLayout
                android:id="@+id/brief_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/brief_footer"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="19dp"
                android:paddingEnd="9dp">

                <TextView
                    android:id="@+id/brief_footer_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sec"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/brief_footer_info"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/brief_ai_disclaimer"
                    android:padding="13dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/brief_footer_settings"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/brief_settings_title"
                    android:padding="13dp"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/brief_provider_required"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sec"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/brief_provider_required_title"
            android:textColor="@color/oneui_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sec"
            android:gravity="center"
            android:text="@string/brief_provider_required_body"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/brief_provider_required_action"
            style="@style/OneUI.ContainedButton"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/brief_provider_required_action"
            android:textAllCaps="false"
            android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme" />
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/brief_loading"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:contentDescription="@string/brief_widget_empty_title"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/intelligence_progress_mono" />

    <View
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/brief_top_bar_gradient"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/brief_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="13dp"
        android:scaleType="centerInside" />
</FrameLayout>
