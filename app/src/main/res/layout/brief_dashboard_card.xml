<?xml version="1.0" encoding="utf-8"?>
<com.tjg.twidget.ui.BriefDashboardCardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:foreground="@drawable/brief_card_ripple"
    android:gravity="center_vertical"
    android:minHeight="0dp"
    android:orientation="vertical"
    android:paddingStart="21dp"
    android:paddingEnd="21dp">

    <ImageView
        android:id="@+id/brief_dashboard_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/brief_dashboard_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brief_dashboard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sec"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/oneui_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brief_dashboard_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sec"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/oneui_text_primary"
            android:textSize="20sp" />
    </LinearLayout>
</com.tjg.twidget.ui.BriefDashboardCardLayout>
