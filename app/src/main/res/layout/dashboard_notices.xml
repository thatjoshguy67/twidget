<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!-- Keep notice text inside the drawer content edge mask and aligned with card content. -->
    <TextView
        android:id="@+id/private_account_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="26dp"
        android:paddingTop="8dp"
        android:paddingEnd="26dp"
        android:paddingBottom="10dp"
        android:text="@string/private_account_notice"
        android:textColor="@color/oneui_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <dev.oneuiproject.oneui.widget.TipsCard
        android:id="@+id/history_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/metric_card_bg"
        android:visibility="gone" />

</LinearLayout>
