<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/brief_api_key_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/brief_api_key_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:includeFontPadding="false"
            android:textColor="@color/oneui_text_primary"
            android:textColorLink="@color/oneui_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/brief_api_key_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:paddingVertical="10dp"
            android:text="@string/brief_api_key_studio_link"
            android:textColor="@color/oneui_accent"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/brief_api_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:autofillHints="password"
            android:background="@drawable/dialog_api_key_underline"
            android:backgroundTint="@null"
            android:gravity="top|start"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:contentDescription="@string/brief_api_key_hint"
            android:hint="@string/brief_api_key_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/oneui_text_primary"
            android:textDirection="ltr"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
