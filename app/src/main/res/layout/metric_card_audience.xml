<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="160dp"
    android:background="@drawable/metric_card_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings_community"
            app:tint="@color/oneui_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/social_all_audience"
            android:textColor="@color/oneui_text_primary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/audience_info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/social_audience_info"
            app:srcCompat="@drawable/ic_info_24"
            app:tint="@color/oneui_text_secondary" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/followers_value"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:maxLines="1"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:textColor="@color/oneui_accent"
        android:textSize="60sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="1sp"
        android:textStyle="bold" />
</dev.oneuiproject.oneui.widget.RoundedLinearLayout>
