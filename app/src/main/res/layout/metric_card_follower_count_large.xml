<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="12dp" android:background="@drawable/dashboard_card_bg"
    android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/followers_value"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:maxLines="3" android:includeFontPadding="false"
            android:textColor="@color/oneui_text_primary" android:textSize="60sp"
            android:breakStrategy="simple" android:hyphenationFrequency="none" />
        <TextView android:id="@+id/dashboard_count_footer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical"
            android:includeFontPadding="false" android:maxLines="1" android:textSize="20sp"
            android:textColor="@color/oneui_text_secondary" />
    </LinearLayout>
</LinearLayout>
