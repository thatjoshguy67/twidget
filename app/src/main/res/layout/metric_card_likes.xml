<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/dashboard_card_bg" android:orientation="vertical"
    android:clipToOutline="true" android:paddingStart="10dp" android:paddingEnd="10dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/dashboard_graph_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/likes" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
        android:includeFontPadding="false" android:textColor="@color/oneui_text_secondary"
        android:layout_marginBottom="6dp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
    <LinearLayout android:id="@+id/dashboard_graph_summary" android:layout_width="158dp" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
        <com.tjg.twidget.ui.CardValueTextView android:id="@+id/likes_delta"
            android:layout_width="match_parent" android:layout_height="30dp" android:gravity="start|center_vertical"
            android:textSize="24sp" android:textColor="@color/dashboard_count_delta" />
        <TextView android:id="@+id/likes_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="50sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="@color/oneui_text_primary" app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp" app:autoSizeMaxTextSize="50sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/metric_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/likes" android:textSize="18sp" android:maxLines="1"
            android:includeFontPadding="false" android:textColor="@color/oneui_text_secondary" />
    </LinearLayout>
    <com.tjg.twidget.ui.MetricChartView android:id="@+id/likes_chart" android:layout_marginStart="10dp"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
