<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/milestone_card"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:clipToOutline="true"
    android:foreground="@drawable/brief_card_ripple"
    android:minHeight="112dp">

    <FrameLayout
        android:id="@+id/milestone_visual"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.tjg.twidget.main.MilestoneArcView
            android:id="@+id/milestone_arc"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_milestone_goals"
            app:tint="@color/oneui_text_primary" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/milestone_edit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/milestone_edit_bg"
        android:contentDescription="@string/milestone_setup_edit"
        android:padding="4dp"
        android:src="@drawable/ic_milestone_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/oneui_text_primary" />

    <LinearLayout
        android:id="@+id/milestone_copy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/milestone_edit"
        app:layout_constraintStart_toEndOf="@id/milestone_visual"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/milestone_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sec"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oneui_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/milestone_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sec"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/oneui_text_primary"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
