<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/oneui_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <FrameLayout
        android:id="@+id/update_suggestion_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/update_suggestion_card_background"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/update_suggestion_lightbulb"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_update_suggestion_lightbulb" />

            <TextView
                android:id="@+id/update_suggestion_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sec"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/oneui_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/update_suggestion_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sec"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/oneui_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/update_suggestion_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/update_suggestion_action_background"
                android:fontFamily="sec"
                android:gravity="center"
                android:minWidth="144dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textAllCaps="false"
                android:textColor="@color/oneui_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/update_suggestion_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/update_suggestion_close"
            android:contentDescription="@string/update_suggestion_close"
            android:padding="0dp" />
    </FrameLayout>
</FrameLayout>
