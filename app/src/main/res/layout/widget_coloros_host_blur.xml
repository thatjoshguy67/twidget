<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_coloros_content_outline" android:clipToOutline="true"
    android:clipChildren="true" android:clipToPadding="true">
    <!-- Background only: launcher effects must not encompass the foreground. -->
    <FrameLayout android:id="@+id/coloros_blur_target" android:layout_width="match_parent"
        android:layout_height="match_parent" android:tag="OplusBlurBg"
        android:background="@drawable/widget_color_os_surface" />
    <LinearLayout android:id="@+id/coloros_native_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:clipChildren="true">
        <TextView android:id="@+id/coloros_native_count" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" android:maxLines="5" android:ellipsize="end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="36sp"
            android:autoSizeStepGranularity="1sp" android:textColor="#FFFFFF" android:breakStrategy="balanced" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/coloros_native_label" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/coloros_native_delta" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/coloros_native_logo" android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" />
            <TextView android:id="@+id/coloros_native_account" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="5dp" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_loading" android:layout_width="30dp" android:layout_height="30dp"
        android:layout_gravity="center" android:indeterminate="true" android:indeterminateDrawable="@drawable/oneui85_spinner"
        android:visibility="gone" />
</FrameLayout>
