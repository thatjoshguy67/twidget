<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_coloros_content_outline" android:clipToOutline="true"
    android:clipChildren="true" android:clipToPadding="true">
    <!-- Background only: launcher effects must not encompass the foreground. -->
    <FrameLayout android:id="@+id/coloros_blur_target" android:layout_width="match_parent"
        android:layout_height="match_parent" android:tag="OplusBlurBg"
        android:background="@drawable/widget_color_os_surface" />
    <LinearLayout android:id="@+id/coloros_native_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:clipChildren="true">
        <FrameLayout android:id="@+id/coloros_native_hero" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipChildren="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/coloros_native_logo" android:layout_width="12dp" android:layout_height="12dp" android:contentDescription="@null" />
            <TextView android:id="@+id/coloros_native_account" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical"
                android:fontFamily="sans-serif" android:textFontWeight="600" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_loading" android:layout_width="30dp" android:layout_height="30dp"
        android:layout_gravity="center" android:indeterminate="true" android:indeterminateDrawable="@drawable/oneui85_spinner"
        android:visibility="gone" />
</FrameLayout>
