

uniform shader tintShader;
uniform half2 uTintShaderSize;
// TODO possible for any transforming with mat3 for trs, but currently just for flipping since there's no requirements at least now.
uniform half2 uTintFlipDirection; 

half useTint() {
    return step(0.01, abs(uTintShaderSize.x * uTintShaderSize.y)); 
}
    
half4 texTint(half2 uv) {
    uv = mix(uv, half2(1 - uv.x, uv.y), step(0.5, uTintFlipDirection.x));
    return tintShader.eval(uv * uTintShaderSize);
}

// get tint color aligned center
half3 getTintColor(half2 uv, half2 resolution) {
    half2 guv = uv;
    half asp = resolution.x / resolution.y;
    if (asp > 1) {
        guv.y /= asp;
        guv.y += 0.5 * (1 - 1 / asp);
    } else {
        guv.x *= asp;
        guv.x += 0.5 * (1 - asp);
    }
    return clamp(texTint(guv).rgb, half3(0), half3(1));
}

// get tint color aligned center
half4 getTintColorAlpha(half2 uv, half2 resolution) {
    half2 guv = uv;
    half asp = resolution.x / resolution.y;
    if (asp > 1) {
        guv.y /= asp;
        guv.y += 0.5 * (1 - 1 / asp);
    } else {
        guv.x *= asp;
        guv.x += 0.5 * (1 - asp);
    }
    half4 tint = texTint(guv);
    return clamp(tint, half4(0), half4(1));
}
        
uniform shader inputShader;
uniform shader lightMapShader;
uniform shader lightMapGlowShader;

uniform half2 uSize;
uniform half uProgress;

uniform half2 uLightMapSize;
uniform half2 uLightMapGlowSize;

uniform half uDitherVariation;

// for view shape
uniform half2 uViewCenter; // normalized value
uniform half uViewAlpha;
uniform int uRoundRectShape;
uniform half uCornerRadius;
uniform half uOutlineThickness;
uniform half2 uRoundRectDirection;
uniform half uCircleRadius;
uniform half2 uBorderWidth; // inset

// directional light 
uniform half2 uLightPos;
uniform half uLightRadius;
uniform half4 uLightColor;
uniform half uLightIntensity;

// glow light
uniform half uGlowIntensity;
uniform half uGlowRadius;
uniform half uGlowSharpness;

// reflection light
uniform half uReflRadius;
uniform half uReflLightIntensity;
uniform half uReflAlbedo;

uniform half uGlobalLuminance;
uniform half uOuterSaturation;
uniform half uSaturation;

uniform half uStretch;
uniform half uStretchDirLit;

uniform half uBoundarySmoothWidth;

// get relative uv based on longer length among width and height of the view.
half2 relativeUv(half2 uv, half2 pos, half scale, half stretch) {
    half asp = uSize.x / uSize.y;
    asp = stretch >= 0.01 ? stretch : asp;

    if (asp > 1) {
    pos.y /= asp;
    uv.y /= asp;
    } else {
    pos.x *= asp;
    uv.x *= asp;
    }
    pos /= scale;
    uv /= scale;
    uv -= pos - half2(0.5);// translate
    return uv;
}

half4 texView(half2 uv) {
    half4 c = inputShader.eval(uv * uSize);
    c.rgb *= c.a;
    return c;
}

half rand(half2 uv) {
    return fract(sin(dot(uv, half2(12.9898, 78.233))) * 43758.5453);
}

half dither(half2 uv, half variation) {
    return 1 + variation * 2 * (rand(uv * 10.0) - 0.5);
}

half sdRoundRect(vec2 fragCoord, half2 center, half2 size, half radius) {
    return length(max(abs(fragCoord - center) - size + radius, 0.0)) - radius;
}

half lightmap(half2 uv, half2 pos, half scale, half intensity, half stretch) {
    uv = relativeUv(uv, pos, scale, stretch);
    return length(lightMapShader.eval(uv * uLightMapSize).rgb) / sqrt(3) * intensity;
}

half lightmapGlow(half2 uv, half2 pos, half scale, half intensity, half stretch) {
    uv = relativeUv(uv, pos, scale, stretch);
    return length(lightMapGlowShader.eval(uv * uLightMapGlowSize).rgb) / sqrt(3) * intensity;
}

float getRadius(half2 halfViewSize, bool useDirection, bool isCornerDirection) {
    if (uRoundRectShape == 0) { // circle
        return uCircleRadius;
    }
    
    if (!useDirection || isCornerDirection) {
        return min(min(halfViewSize.x, halfViewSize.y), uCornerRadius);
    }

    return 0.01;
}

float sdf(vec2 fragCoord, half2 halfViewSize) {
    // detect rounded direction
    vec2 signedQuadrant = fragCoord - uViewCenter * uSize;
    vec2 dv = uRoundRectDirection * signedQuadrant;
    bool useDirection = length(uRoundRectDirection) >= 0.1;
    bool isCornerDirection = dv.x + dv.y >= 1.;
    float radius = getRadius(halfViewSize, useDirection, isCornerDirection);

    half dist = sdRoundRect(fragCoord, uViewCenter * uSize, halfViewSize, radius);
    half attenuation = uOutlineThickness;

    return dist / attenuation;
}

half4 main(vec2 fragCoord) {
    vec2 uv = fragCoord / uSize;

    half4 view = texView(uv);
    half2 halfViewSize = 0.5 * uSize - uBorderWidth;
    half ratioByY = uSize.x / uSize.y;
    half minSizeLength = ratioByY >= 1. ? uSize.y : uSize.x;

    // use proper sdf by primitive type of the view.
    float dist = sdf(fragCoord, halfViewSize);

    // smooth transition factor for inner/outer boundary (0.0 = inner, 1.0 = outer)
    float outFactor = smoothstep(-uBoundarySmoothWidth, uBoundarySmoothWidth, dist);

    // compute light
    half lit = lightmap(uv, uLightPos, uLightRadius, uLightIntensity, uStretchDirLit);

    // compute glow
    // Note that RoundedRect using direction should have disabled the glow light because of limitation of the sdf.
    half useDirection = step(0.1, length(uRoundRectDirection));
    half glowLit = lightmapGlow(uv, uLightPos, uGlowRadius, uGlowIntensity, uStretch);
    half glow = (1 - useDirection) * smoothstep(glowLit, 0, abs(dist));
    glow = pow(glow, uGlowSharpness);

    // compute fakey light reflection by sdf
    half reflLit = lightmapGlow(uv, uLightPos, uReflRadius, uReflLightIntensity, uStretch);
    half distForOut = clamp(dist, 0.0, 0.99);
    half outerReflLit = reflLit * clamp(pow(1 - distForOut, 4.5) + 0.1 * (1 - distForOut), 0, 1);
    half innerReflLit = uReflAlbedo * reflLit;
    reflLit = mix(innerReflLit, outerReflLit, outFactor);
    half refl = smoothstep(uReflRadius, 0, dist);

    // build lights
    half luminance = max(glow * glowLit, refl * reflLit);
    // add directional light on the view (smoothly blended at boundary)
    luminance += mix(lit, 0.0, outFactor);
    half alpha = mix(luminance * uGlobalLuminance, view.a, view.a);
    const half epsilon = 0.0001;
    if (alpha < epsilon) {
    return half4(0, 0, 0, 0);
    }
    luminance = clamp(luminance, 0, 1);

    half4 litColor = half4(0.0);
    litColor.rgb += luminance * uLightColor.rgb;
    litColor.rgb *= dither(fract(uv * uProgress), uDitherVariation);
    litColor.rgb = clamp(litColor.rgb, half3(0), half3(1));

    // apply color tint
    half4 tintColor = getTintColorAlpha(uv, uSize);
    litColor.rgb = mix(litColor.rgb, litColor.rgb * tintColor.rgb, useTint()) * uSaturation;
    // smooth transition for outer saturation at boundary
    litColor.rgb = mix(litColor.rgb, litColor.rgb * uOuterSaturation, outFactor);
    luminance *= tintColor.a;
    litColor.a = luminance * uGlobalLuminance;

    half3 color = litColor.rgb * uGlobalLuminance + view.rgb * view.a * (1 - litColor.a);
    // use premult as default btw lighting and view
    return half4(color, alpha);
}
            