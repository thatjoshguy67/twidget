
const int MaxSpots = 5;
    
uniform shader inputShader;
uniform shader spotLightMapShader;
uniform half2 uLightMapSize;

uniform half2 uSize;
uniform half uTime;

uniform half4 uBaseColor;
uniform int uSpotCount;

uniform half uSpotEnabled[MaxSpots];
uniform half4 uSpotColors[MaxSpots];
uniform half2 uSpotPositions[MaxSpots];
uniform half uSpotScales[MaxSpots];

const half QPI = 3.141592 * 0.25;

half4 spotData(half2 uv, half4 color, half2 pos, half scale) {
    half asp = uSize.x / uSize.y;
    
    pos.x *= asp;
    pos /= scale;
    pos -= half2(0.5, 0.5);
    uv.x *= asp;
    uv /= scale; // scale by radius
    uv -= pos; // translate
    half4 spot = spotLightMapShader.eval(uv * uLightMapSize);
    half alpha = color.a * length(spot.rgb) / sqrt(3); // TODO use actual alpha channel in future.
    return half4(color.a * spot.rgb * color.rgb, alpha);
}

half4 main(vec2 fragCoord) {
    vec2 uv = fragCoord / uSize;
    half4 spots = uBaseColor;
    for (int i = 0; i < MaxSpots; i++) { // AGSL not support conditional loop with uniform at least now
        if (uSpotCount == i) {
            break;
        }
        if (uSpotEnabled[i] > 0) {
            half4 s = spotData(uv, uSpotColors[i], uSpotPositions[i], uSpotScales[i]);
            spots.rgb = s.rgb + spots.rgb * (1 - s.a); // using premult
            spots.a += s.a * (1 - spots.a);
        }
    }
    half4 view = inputShader.eval(fragCoord);
    half useView = step(0.01, view.a);
    
    return mix(spots, view * spots, useView); // tint if there is alpha on the view 
}
        