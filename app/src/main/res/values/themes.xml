<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Twidget" parent="OneUITheme">
        <item name="viewInflaterClass">com.tjg.twidget.ui.TwidgetViewInflater</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="drawerBackgroundColor">@color/oneui_drawer_bg</item>
        <item name="drawerSelectedBackgroundColor">@color/oneui_drawer_selected_bg</item>
    </style>

    <!-- Settings spacing; typography inherits the One UI component defaults. -->
    <style name="Theme.Twidget.Settings" parent="Theme.Twidget">
        <item name="listPreferredItemHeightSmall">@dimen/settings_row_height</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/settings_row_height</item>
        <item name="android:listPreferredItemPaddingStart">@dimen/settings_content_inset</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/settings_content_inset</item>
    </style>

    <style name="Theme.Twidget.Launcher" parent="Theme.Twidget" />

    <style name="WidgetPresetButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsRadioRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_row_height</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">@dimen/settings_content_inset</item>
    </style>

    <style name="TwidgetBriefSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">19dp</item>
        <item name="android:paddingEnd">19dp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="ThemeOverlay.Twidget.ApiKeyDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="viewInflaterClass">com.tjg.twidget.ui.TwidgetViewInflater</item>
        <item name="android:textColorPrimary">@color/oneui_text_primary</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/dialog_api_key_background</item>
        <item name="android:windowElevation">0dp</item>
        <item name="colorPrimary">@color/oneui_accent</item>
    </style>
</resources>
