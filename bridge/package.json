{
  "name": "twidget-bridge",
  "version": "1.4.0",
  "description": "Optional Twidget bridge service; version tracks the Android app release.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.21.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
