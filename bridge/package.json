    "benchmark:local": "node scripts/benchmark-local-history.mjs",
    "history:migrate": "node scripts/migrate-history-to-postgres.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "rettiwt-api": "^7.1.2"
  }
}
